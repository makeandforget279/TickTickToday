# Copy this file to .env and fill in one of the authentication methods below.
# Never commit .env.

# Option 1: use a long-lived access token.
TICKTICK_ACCESS_TOKEN=

# Option 2: use OAuth application credentials.
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=

# Optional. The value in .env overrides redirect-uri from ticktick-today.ini.
# TICKTICK_REDIRECT_URI=http://127.0.0.1:8089/
