<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TickTickToday</AssemblyName>
    <RootNamespace>TickTickToday</RootNamespace>
    <Description>Reschedule overdue TickTick tasks into the next available time slots.</Description>
    <Authors>TickTickToday contributors</Authors>
    <PackageLicenseExpression>0BSD</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.13.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update=".env.example" CopyToOutputDirectory="PreserveNewest" />
    <None Update="periodic-tasks.example.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="ticktick-today.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
